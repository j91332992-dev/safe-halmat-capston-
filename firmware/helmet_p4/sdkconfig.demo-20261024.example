# HANMIR demo build configuration observed 2026-10-24.
# Layer AFTER sdkconfig.defaults. Set Wi-Fi, server IP and tokens LOCALLY via menuconfig.
# NS/WakeNet/pilot shadow intentionally OFF: keep the tested STT wake path.
# Runtime camera timeout commands may override the compiled 600 ms value.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_HANMIR_ENABLE_CAMERA=y
CONFIG_HANMIR_CAMERA_SDA_GPIO=7
CONFIG_HANMIR_CAMERA_SCL_GPIO=8
CONFIG_HANMIR_CAMERA_JPEG_QUALITY=75
CONFIG_HANMIR_CAMERA_TARGET_FPS=15
CONFIG_HANMIR_CAMERA_WS_BUFFER_BYTES=65536
CONFIG_HANMIR_CAMERA_SEND_TIMEOUT_MS=600
CONFIG_HANMIR_SERVER_PORT=8000
CONFIG_HANMIR_DEVICE_ID="helmet-001-av"
CONFIG_HANMIR_ORGANIZATION_ID="org-001"
CONFIG_HANMIR_SITE_ID="site-001"
CONFIG_HANMIR_WORKER_ID="worker-001"
CONFIG_HANMIR_HELMET_ID="helmet-001"
# CONFIG_HANMIR_CAMERA_HTTP_BASELINE is not set
CONFIG_HANMIR_ENABLE_VOICE=y
CONFIG_HANMIR_SPK_BCLK_GPIO=20
CONFIG_HANMIR_SPK_WS_GPIO=21
CONFIG_HANMIR_SPK_DATA_GPIO=22
CONFIG_HANMIR_MIC_BCLK_GPIO=31
CONFIG_HANMIR_MIC_WS_GPIO=34
CONFIG_HANMIR_MIC_DATA_GPIO=36
# CONFIG_HANMIR_MIC_RIGHT_SLOT is not set
# CONFIG_HANMIR_ENABLE_NS is not set
# CONFIG_HANMIR_ENABLE_WAKENET is not set
# CONFIG_HANMIR_LOCAL_WAKE_SHADOW is not set
CONFIG_HANMIR_CAMERA_MAX_BYTES=262144
CONFIG_HANMIR_BAT_SDA_GPIO=33
CONFIG_HANMIR_BAT_SCL_GPIO=32
CONFIG_HANMIR_IMU_RX_GPIO=23
CONFIG_HANMIR_IMU_TX_GPIO=51
CONFIG_HANMIR_ENABLE_BNO_SH2=y
CONFIG_HANMIR_IMU_FALL_SHADOW=y
CONFIG_HANMIR_POSTURE_TILT_DEG=60
CONFIG_HANMIR_POSTURE_HOLD_MS=3000
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X640_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X800_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW8_800X640_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_IF_FORMAT_INDEX_DEFAULT=1
CONFIG_CAMERA_OV5647_CSI_LINESYNC_ENABLE=y
CONFIG_CAMERA_OV5647_DEFAULT_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=2000
CONFIG_CAMERA_OV5647_MIPI_RAW8_800x640_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800x800_50FPS=y
