# Validated non-secret overrides; merge into backend/.env after .env.example.
# Paths below are portable replacements; export the models first.
LOCATION_EMA_ALPHA=0.35
STT_MODEL=gpt-4o-mini-transcribe
STT_LANGUAGE=ko
STT_TIMEOUT_SECONDS=10
STT_COMMAND_PROMPT=한국어 산업 안전 현장 대화입니다. 작업자의 짧은 명령을 정확히 받아쓰고, 들리지 않는 내용은 추측하지 마세요.
YOLO_ENABLED=true
YOLO_MODEL_PATH=./best.pt
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=640
YOLO_GLOVE_CONFIDENCE=0.40
YOLO_FIRE_CONFIDENCE=0.75
YOLO_FIRE_CONFIRM_FRAMES=3
CAMERA_MAX_FRAME_BYTES=524288
YOLO_TARGET_FPS=12
YOLO_PPE_DETAIL_IMAGE_SIZE=640
YOLO_PPE_DETAIL_960_ENABLED=true
YOLO_TRACE_ENABLED=true
YOLO_FAST_OPENVINO_GPU=true
YOLO_HEAD_TIGHT_PROBE=true
CAMERA_DISPLAY_GAMMA=1.35
CAMERA_SHARPEN_AMOUNT=0.2
CAMERA_PREVIEW_GAMMA=1.75
CAMERA_PREVIEW_RED_GAIN=1.08
CAMERA_PREVIEW_BLUE_GAIN=0.96
YOLO_DETAIL_HYBRID_GPU=true
YOLO_VEST_BODY_PROBE=true
YOLO_DETAIL_EARLY_EXIT=true
YOLO_DETAIL_DURING_VOICE=true
YOLO_DETAIL_GPU960_MODEL_PATH=./models/detail_gpu960/best_openvino_model
YOLO_PPE_DETAIL_INTERVAL_SECONDS=0.20
YOLO_VEST_CONFIDENCE=0.25
