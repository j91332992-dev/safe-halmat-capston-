# HANMIR demo overlay, 2026-10-24. Copy .env.example first, then overlay these non-secret values.
# Fill local credentials yourself. Do not commit the resulting .env.
# Model paths are relative to backend/. Export models on the target PC.
# Site dimensions here match the measured room; applied DB map takes priority.
OPENAI_API_KEY=
CAMERA_INGEST_TOKEN=
CALL_DEVICE_TOKEN=
UWB_SURVEY_DEVICE_TOKEN=
OPERATION_MODE="hardware"
STT_MODEL="gpt-4o-mini-transcribe"
STT_LANGUAGE="ko"
STT_TIMEOUT_SECONDS=10.0
STT_PROMPT="한국어 산업 안전 현장 대화입니다. 호출어 투투스와 작업자의 짧은 명령을 정확히 받아쓰고, 들리지 않는 내용은 추측하지 마세요."
STT_COMMAND_PROMPT="한국어 산업 안전 현장 대화입니다. 작업자의 짧은 명령을 정확히 받아쓰고, 들리지 않는 내용은 추측하지 마세요."
WAKE_WORD_FUZZY_THRESHOLD=65.0
WAKE_FOLLOWUP_SECONDS=20.0
GPT_MODEL="gpt-6-luna"
GPT_MAX_OUTPUT_TOKENS=80
GPT_TIMEOUT_SECONDS=5.0
TTS_VOICE="ko-KR-SunHiNeural"
TTS_TIMEOUT_SECONDS=8.0
USE_GPT_RESPONSE=true
USE_EDGE_TTS=true
AUDIO_LOSSLESS_TRANSPORT_ENABLED=true
CALL_VOICE_END_ENABLED=true
CALL_VOICE_END_RMS=120.0
YOLO_ENABLED=true
YOLO_MODEL_PATH="./best.pt"
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=640
YOLO_PERSON_CONFIDENCE=0.35
YOLO_PPE_CONFIDENCE=0.45
YOLO_GLOVE_CONFIDENCE=0.4
YOLO_VEST_CONFIDENCE=0.25
YOLO_FIRE_CONFIDENCE=0.75
YOLO_SMOKE_CONFIDENCE=0.45
SITE_WIDTH_M=5.2
SITE_HEIGHT_M=3.6
UWB_LOG_PATH="./logs/uwb-observations.jsonl"
UWB_LOG_MAX_BYTES=10485760
UWB_LOG_BACKUPS=4
UWB_LOG_RETENTION_DAYS=7.0
UWB_CALIBRATION_ENABLED=false
UWB_MEDIAN_ENABLED=true
UWB_MEDIAN_WINDOW=5
UWB_MEDIAN_SAMPLE_TTL_SECONDS=3.0
UWB_FILTER_RESET_SECONDS=15.0
UWB_FRAME_MAX_AGE_SECONDS=5.0
UWB_FILTER_STATE_TTL_SECONDS=3600.0
UWB_FILTER_MAX_TAGS=1000
UWB_FILTER_STATE_PATH="./logs/uwb-distance-state.sqlite3"
UWB_SPEED_MODE="observe"
UWB_MAX_SPEED_MPS=3.0
UWB_SPEED_MARGIN_M=1.0
UWB_SPEED_MIN_DT_SECONDS=0.02
UWB_SPEED_MAX_GAP_SECONDS=10.0
UWB_SPEED_ACQUIRE_SAMPLES=3
UWB_SPEED_ACQUIRE_SPAN_SECONDS=0.6
UWB_SPEED_ACQUIRE_MARGIN_M=0.75
UWB_SPEED_REACQUIRE_REJECTIONS=5
UWB_SPEED_REACQUIRE_SPAN_SECONDS=2.0
UWB_SPEED_STATE_TTL_SECONDS=3600.0
UWB_QUALITY_MODE="weighted"
UWB_QUALITY_NLOS_WEIGHT=0.15
UWB_QUALITY_WEIGHT_RECOVERY_STEP=0.1
UWB_JUMP_MODE="enforce"
UWB_JUMP_SPEED_MPS=3.0
UWB_JUMP_MARGIN_M=0.2
UWB_JUMP_MAX_STEP_M=0.6
UWB_JUMP_CONFIRM_SAMPLES=3
UWB_JUMP_CONFIRM_SECONDS=0.3
UWB_JUMP_RESET_GAP_SECONDS=1.0
UWB_SURVEY_SITE_ID="site-001"
UWB_QUALITY_GAP_WARN_DB=6.0
UWB_QUALITY_GAP_BAD_DB=12.0
UWB_QUALITY_PATH_WARN_SAMPLES=4.0
UWB_QUALITY_PATH_BAD_SAMPLES=10.0
UWB_QUALITY_RX_WEAK_DBM=-90.0
UWB_QUALITY_FP_WEAK_DBM=-95.0
UWB_QUALITY_GAP_TOLERANCE_DB=0.5
UWB_QUALITY_SUSPECT_WEIGHT=0.35
UWB_QUALITY_UNKNOWN_WEIGHT=0.2
UWB_QUALITY_UNKNOWN_POLICY="downweight"
UWB_QUALITY_RECOVERY_SAMPLES=3
UWB_QUALITY_RECOVERY_SPAN_SECONDS=0.6
UWB_SOLVER_MIN_GEOMETRY_RATIO=1e-06
UWB_SOLVER_MAX_RMSE_M=1.0
CAMERA_MAX_FRAME_BYTES=524288
YOLO_TARGET_FPS=12.0
YOLO_TRACE_ENABLED=true
YOLO_ASYNC_DETAIL=true
YOLO_HEAD_DETAIL_ENABLED=true
YOLO_HEAD_TIGHT_PROBE=true
YOLO_FULL_HAND_EVIDENCE=false
YOLO_GPU_VOICE_FPS=10.0
CAMERA_DISPLAY_GAMMA=1.35
CAMERA_PREVIEW_GAMMA=1.75
CAMERA_PREVIEW_RED_GAIN=1.08
CAMERA_PREVIEW_BLUE_GAIN=0.96
CAMERA_SHARPEN_AMOUNT=0.2
YOLO_FAST_OPENVINO_GPU=true
YOLO_DETAIL_HYBRID_GPU=true
YOLO_DETAIL_GPU960_MODEL_PATH="./best_openvino_960_model"
YOLO_VEST_BODY_PROBE=true
YOLO_DETAIL_EARLY_EXIT=true
YOLO_DETAIL_DURING_VOICE=true
YOLO_OPENVINO_MODEL_PATH="./best_openvino_model"
YOLO_DETAIL_MAX_AGE_SECONDS=1.5
YOLO_PPE_DETAIL_IMAGE_SIZE=640
YOLO_PPE_DETAIL_960_ENABLED=true
YOLO_PPE_DETAIL_INTERVAL_SECONDS=0.2
YOLO_PERSON_TRACK_SECONDS=2.0
YOLO_PPE_WINDOW_SECONDS=6.0
YOLO_PPE_WORN_FRAMES=2
YOLO_PPE_PERSON_FRAMES=3
YOLO_PPE_MISSING_CONSECUTIVE_FRAMES=3
YOLO_FIRE_CONFIRM_FRAMES=3
YOLO_SMOKE_CONFIRM_FRAMES=2
