OPERATION_MODE=hardware
DATABASE_URL=sqlite:///./safety.db
SITE_ID=site-001
SITE_NAME=한미르 UWB 테스트 공간
SITE_WIDTH_M=5.8
SITE_HEIGHT_M=8.2
DEVICE_OFFLINE_SECONDS=20
LOCATION_EMA_ALPHA=0.35
# UWB JSONL capture: 5 files x 10 MiB; expire by oldest record (one server worker).
UWB_LOG_MAX_BYTES=10485760
UWB_LOG_BACKUPS=4
UWB_LOG_RETENTION_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 비워 두면 음성 명령은 고정 응답으로 안전하게 동작합니다.
OPENAI_API_KEY=
USE_WHISPER_STT=true
STT_MODEL=gpt-4o-mini-transcribe
STT_LANGUAGE=ko
STT_TIMEOUT_SECONDS=10
# P4 로컬 호출어 감지 뒤 명령만 업로드할 때 사용하는 STT 힌트.
STT_COMMAND_PROMPT=한국어 산업 안전 현장 대화입니다. 작업자의 짧은 명령을 정확히 받아쓰고, 들리지 않는 내용은 추측하지 마세요.
USE_GPT_RESPONSE=true
GPT_MODEL=gpt-6-luna
GPT_MAX_OUTPUT_TOKENS=80
GPT_TIMEOUT_SECONDS=5
USE_EDGE_TTS=true
TTS_VOICE=ko-KR-SunHiNeural

YOLO_ENABLED=true
YOLO_MODEL_PATH=./best.pt
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=320
YOLO_GLOVE_CONFIDENCE=0.40
YOLO_VEST_CONFIDENCE=0.40
YOLO_FIRE_CONFIDENCE=0.75
YOLO_FIRE_CONFIRM_FRAMES=3

# configure_av_device.py가 안전모와 서버에 같은 비밀키를 생성합니다.
CALL_DEVICE_TOKEN=

# P4 binary camera WebSocket. Set the same nonempty secret in P4 menuconfig.
CAMERA_INGEST_TOKEN=
CAMERA_MAX_FRAME_BYTES=524288
# Shared USB/Wi-Fi distance processing (local SQLite shared by all workers)
# Historical anchor offsets are retained as records, disabled for operation.
UWB_CALIBRATION_ENABLED=false
UWB_MEDIAN_ENABLED=true
UWB_MEDIAN_WINDOW=5
UWB_MEDIAN_SAMPLE_TTL_SECONDS=3
UWB_FILTER_RESET_SECONDS=15
UWB_FRAME_MAX_AGE_SECONDS=5
UWB_FILTER_STATE_TTL_SECONDS=3600
UWB_FILTER_MAX_TAGS=1000
# UWB_FILTER_STATE_PATH=C:/absolute/local/path/uwb-distance-state.sqlite3

# Trial speed checks before coordinate smoothing; observe logs without rejecting updates.
UWB_SPEED_MODE=observe
UWB_MAX_SPEED_MPS=3.0
UWB_SPEED_MARGIN_M=1.0
UWB_SPEED_MIN_DT_SECONDS=0.02
UWB_SPEED_MAX_GAP_SECONDS=10
UWB_SPEED_ACQUIRE_SAMPLES=3
UWB_SPEED_ACQUIRE_SPAN_SECONDS=0.6
UWB_SPEED_ACQUIRE_MARGIN_M=0.75
UWB_SPEED_REACQUIRE_REJECTIONS=5
UWB_SPEED_REACQUIRE_SPAN_SECONDS=2.0
UWB_SPEED_STATE_TTL_SECONDS=3600

# Provisional Ipatov signal quality; observe preserves distances/weights.
UWB_QUALITY_MODE=observe
UWB_QUALITY_GAP_WARN_DB=6
UWB_QUALITY_GAP_BAD_DB=12
UWB_QUALITY_PATH_WARN_SAMPLES=4
UWB_QUALITY_PATH_BAD_SAMPLES=10
UWB_QUALITY_RX_WEAK_DBM=-90
UWB_QUALITY_FP_WEAK_DBM=-95
UWB_QUALITY_GAP_TOLERANCE_DB=0.5
UWB_QUALITY_SUSPECT_WEIGHT=0.35
UWB_QUALITY_UNKNOWN_WEIGHT=0.2
UWB_QUALITY_UNKNOWN_POLICY=downweight
UWB_QUALITY_RECOVERY_SAMPLES=3
UWB_QUALITY_RECOVERY_SPAN_SECONDS=0.6
# Existing solver validity guards (no change to its update algorithm)
UWB_SOLVER_MIN_GEOMETRY_RATIO=0.000001
UWB_SOLVER_MAX_RMSE_M=1.0
