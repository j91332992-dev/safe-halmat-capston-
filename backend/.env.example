OPERATION_MODE=hardware
DATABASE_URL=sqlite:///./safety.db
SITE_ID=site-001
SITE_NAME=한미르 UWB 테스트 공간
SITE_WIDTH_M=5.8
SITE_HEIGHT_M=8.2
DEVICE_OFFLINE_SECONDS=20
LOCATION_EMA_ALPHA=0.35
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 비워 두면 음성 명령은 고정 응답으로 안전하게 동작합니다.
OPENAI_API_KEY=
USE_WHISPER_STT=true
STT_MODEL=gpt-4o-mini-transcribe
STT_LANGUAGE=ko
STT_TIMEOUT_SECONDS=10
# P4 로컬 호출어 감지 뒤 명령만 업로드할 때 사용하는 STT 힌트.
STT_COMMAND_PROMPT=한국어 산업 안전 현장 대화입니다. 작업자의 짧은 명령을 정확히 받아쓰고, 들리지 않는 내용은 추측하지 마세요.
USE_GPT_RESPONSE=true
GPT_MODEL=gpt-6-luna
GPT_MAX_OUTPUT_TOKENS=80
GPT_TIMEOUT_SECONDS=5
USE_EDGE_TTS=true
TTS_VOICE=ko-KR-SunHiNeural

YOLO_ENABLED=true
YOLO_MODEL_PATH=./best.pt
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=320
YOLO_GLOVE_CONFIDENCE=0.40
YOLO_VEST_CONFIDENCE=0.40
YOLO_FIRE_CONFIDENCE=0.75
YOLO_FIRE_CONFIRM_FRAMES=3

# configure_av_device.py가 안전모와 서버에 같은 비밀키를 생성합니다.
CALL_DEVICE_TOKEN=

# P4 binary camera WebSocket. Set the same nonempty secret in P4 menuconfig.
CAMERA_INGEST_TOKEN=
CAMERA_MAX_FRAME_BYTES=524288
